---
import type { Locale } from "../i18n/config";
import type { SiteDictionary } from "../i18n/dictionary";
import { stripLocaleFromPathname, toLocalePath } from "../i18n/config";

interface Props {
    locale: Locale;
    dictionary: SiteDictionary;
}

const { locale, dictionary } = Astro.props;
const { pathnameWithoutLocale } = stripLocaleFromPathname(Astro.url.pathname);

const links = [
    {
        href: toLocalePath(locale, "/"),
        label: dictionary.nav.home,
        key: "home",
    },
    {
        href: toLocalePath(locale, "/contact"),
        label: dictionary.nav.contact,
        key: "contact",
    },
    {
        href: toLocalePath(locale, "/blog"),
        label: dictionary.nav.blog,
        key: "blog",
    },
    {
        href: toLocalePath(locale, "/archive"),
        label: dictionary.nav.archive,
        key: "archive",
    },
    {
        href: toLocalePath(locale, "/tags"),
        label: dictionary.nav.tags,
        key: "tags",
    },
];

const activeSection =
    pathnameWithoutLocale === "/"
        ? "home"
        : pathnameWithoutLocale === "/blog" ||
            pathnameWithoutLocale.startsWith("/blog/")
          ? "blog"
          : pathnameWithoutLocale === "/tags" ||
              pathnameWithoutLocale.startsWith("/tags/")
            ? "tags"
            : pathnameWithoutLocale === "/archive" ||
                pathnameWithoutLocale.startsWith("/archive/")
              ? "archive"
              : pathnameWithoutLocale === "/contact" ||
                  pathnameWithoutLocale.startsWith("/contact/")
                ? "contact"
                : null;
---

<header
    class="site-header"
    lang={locale}
    transition:name="site-header"
    transition:animate="none"
>
    <div class="site-header__inner">
        <a class="site-brand" href={toLocalePath(locale, "/")}>
            <span class="site-brand__identity">
                <strong>{dictionary.brand.name}</strong>
                <span aria-hidden="true">/root</span>
            </span>
        </a>
        <nav class="site-nav">
            <ul>
                {links.map((link) => (
                    <li>
                        <a
                            class:list={[
                                { active: activeSection === link.key },
                            ]}
                            href={link.href}
                            aria-current={
                                activeSection === link.key ? "page" : undefined
                            }
                        >
                            <span aria-hidden="true">~/</span>
                            {link.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>
